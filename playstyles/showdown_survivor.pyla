{"name": "Showdown Survivor", "description": "Follow teammates or try to get closer to the center when no enemies and avoids showdown gas", "brawlers": ["all"], "gamemodes": ["trio showdown"], "author": "Official", "date": "2026-07-04"}
def no_enemy_movement():
    player_pos = get_entity_pos(player_data)
    closest_teammate_coords, dist = find_closest_teammate(teammate_data, player_pos, walls)

    if closest_teammate_coords:
        if dist < TILE_SIZE * 0.65:
            return (0.0, 0.0)
        return (
            closest_teammate_coords[0] - player_pos[0],
            closest_teammate_coords[1] - player_pos[1],
        )

    objective_movement = get_recent_objective_movement(player_pos)
    if objective_movement:
        return objective_movement

    # The camera follows the player, so screen centre is not map centre. The
    # central explorer retains a stable heading and refines it from gas-edge
    # evidence; A* handles obstacles without changing the strategic goal.
    return get_exploration_movement(player_data, walls)

def avoid_poison_gas():
    opposite_direction = {"up": JOYSTICK_RADIUS, "down": -JOYSTICK_RADIUS, "left": JOYSTICK_RADIUS, "right": -JOYSTICK_RADIUS}
    poison_gas = is_there_poison_gas(player_data)
    x, y = 0, 0
    if poison_gas["up"] or poison_gas["down"]:
        if poison_gas["up"] > poison_gas["down"]:
            y = opposite_direction["up"]
        else:
            y = opposite_direction["down"]
    if poison_gas["left"] or poison_gas["right"]:
        if poison_gas["left"] > poison_gas["right"]:
            x = opposite_direction["left"]
        else:
            x = opposite_direction["right"]

    return (x, y) if x != 0 or y != 0 else None

brawler_info = brawlers_info.get(brawler)
if not brawler_info:
    raise ValueError(f"Brawler '{brawler}' not found in brawlers info.")
must_hold_attack = must_brawler_hold_attack(brawler, brawlers_info)
# if a brawler has been holding an attack for its max duration + the bot setting, then we release
if must_hold_attack and persistent_data["time_since_holding_attack"] is not None and time.time() - persistent_data["time_since_holding_attack"] >= brawler_info['hold_attack'] + seconds_to_hold_attack_after_reaching_max:
    attack(touch_up=True, touch_down=False)
    persistent_data["time_since_holding_attack"] = None

safe_range, attack_range, super_range = get_brawler_range(brawler)
player_pos = get_entity_pos(player_data)
#if debug: print("found player pos:", player_pos)
anti_poison_gas_movement = avoid_poison_gas()
if anti_poison_gas_movement:
    movement = anti_poison_gas_movement
if not is_there_enemy(enemy_data):
    if not anti_poison_gas_movement:
        movement = no_enemy_movement()
else:
    enemy_coords, enemy_distance = find_closest_enemy(enemy_data, player_pos, walls, "attack")
    if enemy_coords is None:
        if not anti_poison_gas_movement:
            movement = no_enemy_movement()
    else:
        #if debug: print("found enemy pos:", enemy_coords)
        # Refresh the active objective while it is visible. If the target or
        # box disappears, continue to its last position before regrouping.
        remember_objective(enemy_coords)
        attack_hittable = is_enemy_hittable(
            player_pos, enemy_coords, walls, "attack"
        )
        super_hittable = (
            is_super_ready
            and is_enemy_hittable(
                player_pos, enemy_coords, walls, "super"
            )
        )
        enemy_actionable = attack_hittable or super_hittable
        if not anti_poison_gas_movement:
            if enemy_actionable:
                direction_x = enemy_coords[0] - player_pos[0]
                direction_y = enemy_coords[1] - player_pos[1]
                movement = (direction_x, direction_y)
            else:
                # A wall-blocked enemy is not an immediate task. Regroup with
                # one stable teammate instead of indecisively circling terrain.
                movement = no_enemy_movement()

        if is_super_ready and persistent_data["time_since_holding_attack"] is None:
            super_type = brawler_info['super_type']
            enemy_hittable = super_hittable

            if (enemy_hittable and
                    (enemy_distance <= super_range
                     or super_type in ["spawnable", "other"]
                     or (brawler in ["stu", "surge"] and super_type == "charge" and enemy_distance <= super_range + attack_range)
                    )):
                if is_hypercharge_ready:
                    use_hypercharge()

                use_super()

        # Attack if enemy is within attack range and hittable
        if enemy_distance <= attack_range:
            enemy_hittable = attack_hittable
            if enemy_hittable:
                # If the target disappears after this shot (especially a
                # power-cube box), keep walking to its last position instead
                # of immediately switching back to teammate following.
                remember_objective(enemy_coords)
                if is_gadget_ready and persistent_data["time_since_holding_attack"] is None:
                    use_gadget()

                if not must_hold_attack:
                    attack()
                else:
                    if persistent_data["time_since_holding_attack"] is None:
                        persistent_data["time_since_holding_attack"] = time.time()
                        attack(touch_up=False, touch_down=True)
                    elif time.time() - persistent_data["time_since_holding_attack"] >= brawlers_info[brawler]['hold_attack']:
                        attack(touch_up=True, touch_down=False)
                        persistent_data["time_since_holding_attack"] = None
